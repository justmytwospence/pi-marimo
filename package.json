{
  "name": "pi-marimo",
  "version": "0.2.0",
  "description": "Live marimo notebooks in Pi: kernel state in context, and a terminal notebook view (outline and detail, docked beside the chat) where you run cells, drive widgets and tables, and read what the agent changed.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "marimo",
    "notebook",
    "jupyter",
    "tui",
    "terminal"
  ],
  "author": "Spencer Boucher",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justmytwospence/pi-marimo.git"
  },
  "homepage": "https://github.com/justmytwospence/pi-marimo#readme",
  "bugs": {
    "url": "https://github.com/justmytwospence/pi-marimo/issues"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "neovim": "^5.5.0",
    "parse5": "^8.0.1",
    "shiki": "^4.5.0"
  }
}
